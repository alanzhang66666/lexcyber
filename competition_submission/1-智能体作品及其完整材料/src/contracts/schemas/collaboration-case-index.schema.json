{
  "title": "LexCyber collaboration case dataset index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_id", "dataset_id", "revision", "legal_review_status", "cases"],
  "properties": {
    "schema_version": { "const": "lexcyber.demo-index.v1" },
    "producer_id": { "$ref": "#/$defs/stableId" },
    "dataset_id": { "$ref": "#/$defs/stableId" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "legal_review_status": { "type": "string", "minLength": 1, "maxLength": 128 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_code", "external_case_id", "bundle"],
        "properties": {
          "case_id": { "$ref": "#/$defs/stableId" },
          "case_code": { "type": "string", "minLength": 1, "maxLength": 32 },
          "external_case_id": { "$ref": "#/$defs/stableId" },
          "bundle": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+\\.json$" }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
