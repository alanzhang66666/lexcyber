# Database and internal service credentials. Replace before running.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
ENGINE_DB_PASSWORD=change-me-engine
ENGINE_SERVICE_TOKEN=change-me-engine-token
MODEL_CONFIG_ENCRYPTION_KEY=change-me-model-config-encryption-key

# DeepSeek/OpenAI-compatible model. Keep the real key outside this directory.
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-v4-flash
MODEL_API_BASE_URL=https://api.deepseek.com/v1
# 可留空并在登录后的「用户设置 → 模型 API 接入」中填写。
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_CALLS_PER_TASK=3
MODEL_MAX_RETRIES=1
MODEL_MAX_CONCURRENCY=2
ALLOW_STUB_MODEL=false

# Application controls
WORKFLOW_PROFILE=competition
APP_ENV=competition
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_ROOT=/data/objects
KNOWLEDGE_ROOT=/opt/lexcyber/knowledge
LEGAL_SOURCE_SEARCH_ENABLED=true
SENTENCING_ENABLED=false
REVIEW_AUTH_MODE=trusted-header
SERVER_PORT=8081

# Optional dependency mirrors for Docker builds.
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
# MAVEN_MIRROR_URL=
