POSTGRES_PASSWORD=
APP_DB_PASSWORD=
ENGINE_DB_PASSWORD=
ENGINE_SERVICE_TOKEN=
MINIO_ROOT_USER=lexcyber
MINIO_ROOT_PASSWORD=
# Generate the five required secrets before copying this file to .env.v03.
# Example: openssl rand -hex 32
MODEL_PROVIDER=stub
MODEL_NAME=stub-general-v1
MODEL_API_BASE_URL=https://api.deepseek.com/v1
# Comma-separated exact URLs allowed for deployment-wide model configuration.
# Blank permits only MODEL_API_BASE_URL. Set MODEL_CONFIG_ADMIN_USERNAMES below.
# MODEL_API_BASE_URL_ALLOWLIST=https://api.deepseek.com/v1,https://api.openai.com/v1
# MODEL_CONFIG_ADMIN_USERNAMES=admin
MODEL_TIMEOUT_SECONDS=45
WORKFLOW_PROFILE=stub
SENTENCING_ENABLED=true
LEGAL_SOURCE_SEARCH_ENABLED=true
