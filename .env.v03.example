POSTGRES_PASSWORD=dev-postgres-change-me
APP_DB_PASSWORD=dev-app-change-me
ENGINE_DB_PASSWORD=dev-engine-change-me
ENGINE_SERVICE_TOKEN=dev-engine-token-change-me
MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=dev-minio-change-me
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-chat
# MODEL_API_KEY=
# Generate with `openssl rand -base64 32`; write only to `.env.v03`, never commit.
# MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_API_BASE_URL=https://api.deepseek.com/v1
# Comma-separated exact URLs allowed for deployment-wide model configuration.
# Blank permits only MODEL_API_BASE_URL. Set MODEL_CONFIG_ADMIN_USERNAMES below.
# MODEL_API_BASE_URL_ALLOWLIST=https://api.deepseek.com/v1,https://api.openai.com/v1
# MODEL_CONFIG_ADMIN_USERNAMES=admin
MODEL_TIMEOUT_SECONDS=45
WORKFLOW_PROFILE=stub
SENTENCING_ENABLED=false
LEGAL_SOURCE_SEARCH_ENABLED=false
# Allows legacy /v1 module-state writes used by the three-case demo importer.
# Default off: /v1 module PUT/confirm return 410 MODULE_WRITE_RETIRED.
DEMO_IMPORT_ENABLED=false
# KNOWLEDGE_BASE_URL=
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=

# Optional dependency mirrors. Defaults are the official registries when unset.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
